{
  "extraKnownMarketplaces": {
    "devflow": {
      "source": {
        "source": "github",
        "repo": "jbrianfrancis-ir/devflow"
      }
    }
  },
  "enabledPlugins": {
    "devflow@devflow": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  }
}
